# Ghostty Configuration
# https://ghostty.org/docs/config

# Font
font-family = MonaspiceRn Nerd Font Mono
# Ghostty 通过重复 font-family 指定 fallback（不是逗号分隔）
font-family = Maple Mono NF CN
font-size = 15
font-thicken = true

# Theme
theme = Catppuccin Mocha

# Window
window-padding-x = 8
window-padding-y = 8
window-decoration = true

# Background image
background-image = ~/.config/ghostty/bg.jpg
background-image-opacity = 0.3
background-image-fit = cover
background-blur-radius = 20

# Cursor
cursor-style = block
cursor-style-blink = false

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title

# macOS
macos-non-native-fullscreen = false
macos-titlebar-style = tabs

# Copy/Paste behavior
copy-on-select = false
clipboard-trim-trailing-spaces = true

# Keybindings (keep macOS standard)
# Cmd+T = new tab
# Cmd+W = close tab
# Cmd+N = new window
# Cmd+Shift+[ / ] = switch tabs
# Cmd+1-9 = go to tab 1-9

# Scrollback
scrollback-limit = 10000

# Mouse
mouse-hide-while-typing = true
# 允许滚轮直接滚动终端滚动缓冲区
mouse-scroll-multiplier = 1
# 按住 Shift 不强制把鼠标事件交给程序（便于直接滚动）
mouse-shift-capture = false
