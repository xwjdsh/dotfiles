#!/usr/bin/env bash
# Bootstrap this dotfiles repo: install tools, then symlink every package with stow.
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DOTFILES_DIR"

OS="$(uname -s)"

# --- Homebrew / packages ----------------------------------------------------
if command -v brew >/dev/null; then
  command -v stow >/dev/null || brew install stow
  if [[ "${SKIP_BREW:-0}" != "1" ]]; then
    echo "🍺 brew bundle..."
    # A single failing formula/cask/extension must not stop the stow step below.
    brew bundle --file="$DOTFILES_DIR/Brewfile" ||
      echo "⚠️  brew bundle reported failures (see above); continuing." >&2
  fi
elif ! command -v stow >/dev/null; then
  echo "stow not found and Homebrew is unavailable; install stow first." >&2
  exit 1
fi

# --- oh-my-zsh (required by zsh/.zshrc) ---------------------------------------
if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
  echo "💫 Installing oh-my-zsh..."
  RUNZSH=no CHSH=no KEEP_ZSHRC=yes \
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi

# --- Migration: drop dangling symlinks left from the pre-packages/ layout ----
# (stow cannot take over links that point outside the new stow dir.)
for dir in packages/*/; do
  while IFS= read -r -d '' src; do
    target="$HOME/${src#"$dir"}"
    if [[ -L "$target" && ! -e "$target" ]]; then
      echo "🧹 Removing dangling link $target"
      rm "$target"
    fi
  done < <(find "$dir" -mindepth 1 -print0)
done

# --- Stow every package under packages/ -------------------------------------
# (stow refuses to overwrite existing real files; move them away first.)
for dir in packages/*/; do
  pkg="$(basename "$dir")"
  echo "📦 Stowing $pkg..."
  stow -R -d packages --target="$HOME" "$pkg"
done

# --- tmux plugins -------------------------------------------------------------
tpm_install="${HOMEBREW_PREFIX:-$(brew --prefix 2>/dev/null || true)}/opt/tpm/share/tpm/bin/install_plugins"
if [[ -x "$tpm_install" ]]; then
  echo "🧩 Installing tmux plugins..."
  "$tpm_install" || true
fi

# --- macOS-only ---------------------------------------------------------------
if [[ "$OS" == "Darwin" ]]; then
  icloud="$HOME/Library/Mobile Documents/com~apple~CloudDocs"
  [[ -d "$icloud" ]] && ln -sfn "$icloud" "$HOME/icloud"
fi

echo "✅ All done!"
