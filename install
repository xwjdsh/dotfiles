#!/usr/bin/env bash
# Bootstrap this dotfiles repo: Homebrew + stow, then symlink every package.
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DOTFILES_DIR"

OS="$(uname -s)"

# --- Homebrew + stow ----------------------------------------------------------
# Only what's needed to link the configs; run `brew sync` afterwards for the rest.
if ! command -v brew >/dev/null; then
  echo "🍺 Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi
command -v stow >/dev/null || brew install stow

# --- oh-my-zsh (required by zsh/.zshrc) ---------------------------------------
if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
  echo "💫 Installing oh-my-zsh..."
  RUNZSH=no CHSH=no KEEP_ZSHRC=yes \
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi

# --- Stow every package under packages/ -------------------------------------
# (stow refuses to overwrite existing real files; move them away first.)
# Pre-create ~/.local/bin so stow links files into it instead of linking the
# whole directory into this repo.
mkdir -p "$HOME/.local/bin"

# stow only recognises links pointing into its own stow dir, so links left by an
# earlier layout read as "not owned by stow" and abort the run. Drop the dead
# ones first -- they point at paths that no longer exist anyway.
prune_dead_links() {
  local rel target
  while IFS= read -r rel; do
    target="$HOME/$rel"
    if [[ -L "$target" && ! -e "$target" ]]; then
      echo "   🧹 Removing dead link ~/$rel"
      rm "$target"
    fi
  done < <(cd "packages/$1" && find . -mindepth 1 | sed 's|^\./||')
}

for dir in packages/*/; do
  pkg="$(basename "$dir")"
  echo "📦 Stowing $pkg..."
  prune_dead_links "$pkg"
  stow -R -d packages --target="$HOME" "$pkg"
done

# --- macOS-only ---------------------------------------------------------------
if [[ "$OS" == "Darwin" ]]; then
  icloud="$HOME/Library/Mobile Documents/com~apple~CloudDocs"
  [[ -d "$icloud" ]] && ln -sfn "$icloud" "$HOME/icloud"
fi

echo "✅ All done!"
